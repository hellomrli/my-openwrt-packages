#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

start_service() {
	local enabled gateway range workers measure_workers timezone
	config_load gxmobile
	config_get_bool enabled main enabled 1
	/usr/libexec/gxmobile-schedule sync || return 1
	[ "$enabled" = 1 ] || return 0
	config_get gateway main gateway 'http://192.168.50.250:8080'
	config_get range main range '3221225600-3221226800'
	config_get workers main workers 4
	config_get measure_workers main measure_workers 2
	procd_open_instance
	procd_set_param command /usr/bin/gxmobile-scan -web -no-pause \
		-addr 127.0.0.1:8081 -out /etc/gxmobile -gateway "$gateway" \
		-range "$range" -workers "$workers" -measure-workers "$measure_workers"
	procd_set_param respawn 3600 5 5
	timezone=$(uci -q get 'system.@system[0].zonename')
	procd_set_param env TZ="${timezone:-Asia/Shanghai}"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger gxmobile
}
