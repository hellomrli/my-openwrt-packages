+func TestParseAnytlsURLHonorsInsecureAliases(t *testing.T) {
+	tests := []struct {
+		name     string
+		link     string
+		insecure bool
+		sni      string
+	}{
+		{name: "default_verifies", link: "anytls://pass@example.com:443", insecure: false, sni: "example.com"},
+		{name: "insecure_1", link: "anytls://pass@example.com:443?insecure=1", insecure: true, sni: "example.com"},
+		{name: "insecure_0", link: "anytls://pass@example.com:443?insecure=0", insecure: false, sni: "example.com"},
+		{name: "allowInsecure_1", link: "anytls://pass@example.com:443?allowInsecure=1", insecure: true, sni: "example.com"},
+		{name: "sni_override", link: "anytls://pass@example.com:443?sni=cdn.example.net&insecure=1", insecure: true, sni: "cdn.example.net"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			s, err := parseAnytlsURL(tt.link)
+			if err != nil {
+				t.Fatalf("parseAnytlsURL(%q) error = %v", tt.link, err)
+			}
+			if s.Insecure != tt.insecure {
+				t.Fatalf("parseAnytlsURL(%q).Insecure = %v, want %v", tt.link, s.Insecure, tt.insecure)
+			}
+			if s.Sni != tt.sni {
+				t.Fatalf("parseAnytlsURL(%q).Sni = %q, want %q", tt.link, s.Sni, tt.sni)
+			}
+		})
+	}
+}
