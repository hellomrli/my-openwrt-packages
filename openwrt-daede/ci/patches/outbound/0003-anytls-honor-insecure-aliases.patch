+// insecureFromQuery reports whether the link asks to skip certificate
+// verification. The shared helper covers the spellings the other TLS dialers
+// accept; anytls links additionally carry "insecure", which is what daed's own
+// node form and most anytls subscriptions emit. Only this package accepts both
+// families, so the shared helper keeps its existing semantics.
+func insecureFromQuery(query url.Values) bool {
+	if dialer.AllowInsecureFromQuery(query) {
+		return true
+	}
+	// Absent or unparsable values keep verification on.
+	insecure, err := strconv.ParseBool(query.Get("insecure"))
+	return err == nil && insecure
+}
