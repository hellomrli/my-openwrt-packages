+func TestInsecureFromQuery(t *testing.T) {
+	tests := []struct {
+		name  string
+		query string
+		want  bool
+	}{
+		{name: "absent", query: "", want: false},
+		{name: "insecure_1", query: "insecure=1", want: true},
+		{name: "insecure_true", query: "insecure=true", want: true},
+		{name: "insecure_0", query: "insecure=0", want: false},
+		{name: "insecure_false", query: "insecure=false", want: false},
+		{name: "insecure_invalid", query: "insecure=yes-please", want: false},
+		{name: "allowInsecure_1", query: "allowInsecure=1", want: true},
+		{name: "allow_insecure_true", query: "allow_insecure=true", want: true},
+		{name: "allowinsecure_1", query: "allowinsecure=1", want: true},
+		{name: "skipVerify", query: "skipVerify=true", want: true},
+		{name: "shared_key_wins_over_insecure_0", query: "insecure=0&allowInsecure=1", want: true},
+		{name: "insecure_wins_over_shared_0", query: "insecure=1&allowInsecure=0", want: true},
+		{name: "both_disabled", query: "insecure=0&allowInsecure=0", want: false},
+		{name: "unrelated_params", query: "sni=example.com&udp=1", want: false},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			query, err := url.ParseQuery(tt.query)
+			if err != nil {
+				t.Fatalf("ParseQuery(%q) error = %v", tt.query, err)
+			}
+			if got := insecureFromQuery(query); got != tt.want {
+				t.Fatalf("insecureFromQuery(%q) = %v, want %v", tt.query, got, tt.want)
+			}
+		})
+	}
+}
