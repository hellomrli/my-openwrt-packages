#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

start_service() {
	local enabled host port gateway base_url format access_log device
	config_load iptv-catchup
	config_get_bool enabled main enabled 0
	[ "$enabled" = 1 ] || return 0
	config_get host main listen_address
	config_get port main port 8088
	config_get gateway main gateway 'http://127.0.0.1:8080'
	config_get base_url main base_url
	config_get format main format ku9
	config_get access_log main access_log errors
	. /lib/functions/network.sh
	if [ -z "$host" ]; then
		network_get_ipaddr host lan || {
			logger -t iptv-catchup 'LAN IPv4 is unavailable; waiting for interface reload'
			return 0
		}
	fi
	network_get_device device lan
	procd_open_instance main
	procd_set_param command /usr/bin/python3 -B -u /usr/lib/iptv-catchup/openwrt_service.py \
		--host "$host" --port "$port" --gateway "$gateway" --base-url "$base_url" --format "$format" \
		--access-log "$access_log"
	procd_set_param user nobody
	procd_set_param group nogroup
	procd_set_param env PYTHONDONTWRITEBYTECODE=1
	procd_set_param file /etc/config/iptv-catchup /etc/iptv-catchup/IPTV.m3u /etc/iptv-catchup/catchup.json
	[ -z "$device" ] || procd_set_param netdev "$device"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger iptv-catchup
	procd_add_reload_interface_trigger lan
}
