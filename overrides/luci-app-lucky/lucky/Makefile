# SPDX-License-Identifier: MIT
#
# 本文件是 luci-app-lucky 同步结果的覆盖文件（见 overrides/README.md）。
#
# Lucky 从 3.x 起只在官方文件服务 https://release.66666.host/ 发布：GitHub 上的
# gdy666/lucky 停在 v2.27.2，3.x 既没有源码也没有 release 资产，只有预编译二进制
# （tar.gz）和 OpenWrt APK。上游 gdy666/luci-app-lucky 仓库里的这份 Makefile 仍然
# 指向 GitHub release，同步回来会把 3.x 覆盖回 2.27.2，因此在这里固定一份。
#
# 版本、下载地址和逐架构 sha256 由固件仓库的
# .github/scripts/pin-lucky-source.py 在每次构建前按官方 checksums.txt 刷新，
# 并写入下面 ARCH MAP 的标记之间。

include $(TOPDIR)/rules.mk

PKG_NAME:=lucky
PKG_VERSION:=3.1.4
PKG_RELEASE:=1

PKG_LICENSE:=MIT
PKG_LICENSE_FILES:=LICENSE
PKG_MAINTAINER:=GDY666 <gdy666@foxmail.com>

# 版本、下载地址和逐架构 sha256 由固件仓库的 .github/scripts/pin-lucky-source.py
# 依据官方 checksums.txt 生成。请保留下面两行标记：标记之间的内容会被整体替换，
# 标记之外的手写内容保留。
# >>> ARCH MAP
# Generated by .github/scripts/pin-lucky-source.py from the vendor
# checksums.txt; only the marker lines around this block are hand-written.
LUCKY_ARCH:=
LUCKY_HASH:=

ifeq ($(ARCH),aarch64)
  LUCKY_ARCH:=arm64
  LUCKY_HASH:=6107df093ba61151f1134680009b515aef4a95b87baf348668499a2b6479b02c
endif
ifeq ($(ARCH),arm)
  ifeq ($(CONFIG_arm_v7),y)
    LUCKY_ARCH:=armv7
    LUCKY_HASH:=9b53c4d8eb1b58d6ff134e478631b89eef34e22550115e72833c802ab00492d0
  else ifeq ($(CONFIG_arm_v6),y)
    LUCKY_ARCH:=armv6
    LUCKY_HASH:=fcaef5b0e5de3a2903eed9c1dc976956a14af3be68c5a653260340b415d8d02a
  else ifneq ($(filter arm_arm926ej-s arm_xscale,$(ARCH_PACKAGES)),)
    LUCKY_ARCH:=armv5
    LUCKY_HASH:=1739c834f211589c3cabe8f0bb9f11d976046f9eedb77430416acaa4bf6bb4a0
  endif
endif
ifeq ($(ARCH),i386)
  LUCKY_ARCH:=i386
  LUCKY_HASH:=5bc5046dc374c2e25d0959b144624826dafd8962392c55316afc617b0a4beb49
endif
ifeq ($(ARCH),x86_64)
  LUCKY_ARCH:=x86_64
  LUCKY_HASH:=cb747e7859ecbb7f1fc273d47744e42777ab2937c7ff25c3a003648fbfff5b7d
endif
ifeq ($(ARCH),riscv64)
  LUCKY_ARCH:=riscv64
  LUCKY_HASH:=35096a105cb845b33ef0dc2d395e9f2b81248710e41c53ea3c2b265462c08075
endif
ifeq ($(ARCH),mips)
  ifeq ($(CONFIG_SOFT_FLOAT),y)
    LUCKY_ARCH:=mips_softfloat
    LUCKY_HASH:=d163669f4af534c433277be7e76b730e1a66a49e48b1de17663ae1c3ded02258
  else
    LUCKY_ARCH:=mips_hardfloat
    LUCKY_HASH:=10c0f16bdd18a7a337de1e92d62b2d8225eb64dc85ecabdfef409d5308848ec7
  endif
endif
ifeq ($(ARCH),mipsel)
  ifeq ($(CONFIG_SOFT_FLOAT),y)
    LUCKY_ARCH:=mipsle_softfloat
    LUCKY_HASH:=228710207d43c476f83c66de4c43dab8c5340539ab84a52b52a4ecba25d87f86
  else
    LUCKY_ARCH:=mipsle_hardfloat
    LUCKY_HASH:=a104e819a2f0c29e35ea0c9dc1c46de2c18520afff992d65ba3ed1275b660561
  endif
endif
# <<< ARCH MAP

PKG_SOURCE:=lucky_$(PKG_VERSION)_Linux_$(LUCKY_ARCH).tar.gz
PKG_SOURCE_URL:=https://release.66666.host/v3.1.4beta/3.1.4_lucky
# 未列入 ARCH MAP 的架构拿不到校验和，退回上游原来的 skip，让下载步骤自行判定；
# Package/lucky 的 DEPENDS 已经把这些架构排除在外。
PKG_HASH:=$(if $(LUCKY_HASH),$(LUCKY_HASH),skip)
PKG_BUILD_DIR:=$(BUILD_DIR)/$(PKG_NAME)-$(PKG_VERSION)

include $(INCLUDE_DIR)/package.mk

define Package/lucky
  SECTION:=net
  CATEGORY:=Network
  TITLE:=Lucky network utility
  DEPENDS:=@(aarch64||arm||i386||mips||mipsel||riscv64||x86_64) @(!TARGET_gemini)
  URL:=https://release.66666.host/
endef

define Package/lucky/description
 Lucky provides IPv4/IPv6 port forwarding, DDNS, Wake-on-LAN,
 reverse proxy, ACME automation and related network services.

 3.x is distributed as a prebuilt binary from the vendor's own file
 service (https://release.66666.host/); the GitHub project stopped
 publishing releases after v2.27.2.
endef

define Package/lucky/conffiles
/etc/config/lucky
endef

define Build/Prepare
	gzip -dc $(DL_DIR)/$(PKG_SOURCE) | $(HOST_TAR) -C $(PKG_BUILD_DIR) -xf -
	$(Build/Patch)
endef

define Build/Compile
endef

define Package/lucky/install
	$(INSTALL_DIR) $(1)/usr/bin
	$(INSTALL_BIN) $(PKG_BUILD_DIR)/lucky $(1)/usr/bin/lucky
	$(INSTALL_DIR) $(1)/usr/libexec
	$(INSTALL_BIN) ./files/lucky-call $(1)/usr/libexec/lucky-call
	$(INSTALL_DIR) $(1)/usr/share/lucky
	echo '$(LUCKY_ARCH)' > $(1)/usr/share/lucky/arch
	$(INSTALL_DIR) $(1)/etc/init.d
	$(INSTALL_BIN) ./files/lucky.init $(1)/etc/init.d/lucky
	$(INSTALL_DIR) $(1)/etc/config
	$(INSTALL_CONF) ./files/luckyuci $(1)/etc/config/lucky
endef

$(eval $(call BuildPackage,lucky))
